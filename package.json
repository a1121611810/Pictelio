{
  "name": "pictelio",
  "version": "1.5.6",
  "private": true,
  "description": "Pictelio monorepo - Lynx single-engine Pixiv client + landing page",
  "homepage": "https://a1121611810.github.io/Pictelio/",
  "type": "module",
  "scripts": {
    "vp": "node_modules/.bin/vp",
    "dev": "vp run --filter pictelio-app-lynx dev",
    "dev:app-lynx": "vp run --filter pictelio-app-lynx dev",
    "dev:website": "vp run --filter pictelio-website dev",
    "dev:android-host": "vp run --filter @pictelio/android-host dev:android",
    "dev:all": "vp run --parallel --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira --filter @pictelio/novel-export dev",
    "build": "vp run --filter pictelio-app-lynx build",
    "build:app-lynx": "vp run --filter pictelio-app-lynx build",
    "build:website": "vp run --filter pictelio-website build",
    "build:all": "vp run --parallel --concurrency-limit ${RUN_CONCURRENCY:-2} --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira --filter @pictelio/novel-export build",
    "check": "vp run --filter pictelio-app-lynx check",
    "check:app-lynx": "vp run --filter pictelio-app-lynx check",
    "check:android-host": "vp run --filter @pictelio/android-host check",
    "check:ugoira": "vp run --filter @pictelio/ugoira check",
    "check:update-check": "vp run --filter @pictelio/update-check check",
    "check:novel-export": "vp run --filter @pictelio/novel-export check",
    "check:net-diagnostics": "vp run --filter @pictelio/net-diagnostics check",
    "check:all": "pnpm vp run --cache --parallel --concurrency-limit ${RUN_CONCURRENCY:-2} --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira --filter @pictelio/update-check --filter @pictelio/novel-export --filter @pictelio/net-diagnostics --filter @pictelio/search-core --filter @pictelio/ranking-core check",
    "preview": "vp run --filter pictelio-app-lynx preview",
    "preview:app-lynx": "vp run --filter pictelio-app-lynx preview",
    "preview:website": "vp run --filter pictelio-website preview",
    "preview:all": "vp run --parallel --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira --filter @pictelio/novel-export preview",
    "test": "pnpm vp run --filter pictelio-app-lynx test",
    "test:app-lynx": "vp run --filter pictelio-app-lynx test",
    "test:android-host": "vp run --filter @pictelio/android-host test",
    "test:android-host:unit": "vp run --filter @pictelio/android-host test:android:unit",
    "test:android-host:e2e": "pnpm --filter @pictelio/android-host exec vitest run -c tests/android-e2e/vitest.config.ts",
    "test:ugoira": "vp run --filter @pictelio/ugoira test",
    "test:update-check": "vp run --filter @pictelio/update-check test",
    "test:novel-export": "vp run --filter @pictelio/novel-export test",
    "test:net-diagnostics": "vp run --filter @pictelio/net-diagnostics test",
    "test:mutation": "vp run --parallel --filter @pictelio/ugoira --filter @pictelio/update-check mutation",
    "test:all": "pnpm vp run --parallel --concurrency-limit ${RUN_CONCURRENCY:-2} --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira --filter @pictelio/update-check --filter @pictelio/novel-export --filter @pictelio/net-diagnostics --filter @pictelio/search-core --filter @pictelio/ranking-core --filter @pictelio/android-host test",
    "lint": "pnpm vp lint",
    "lint:all": "pnpm vp lint",
    "fmt": "pnpm vp fmt --write",
    "fmt:all": "pnpm vp fmt --write",
    "fmt:check": "pnpm vp fmt --check",
    "outdated": "pnpm vp outdated",
    "build:android-host": "vp run --filter @pictelio/android-host build:android",
    "build:android-host:release": "vp run --filter @pictelio/android-host build:android:release",
    "release:android-host": "vp run --filter @pictelio/android-host release",
    "release:android-host:transition": "PICTELIO_RELEASE_BRANCH=release/transition-6.2.0 vp run --filter @pictelio/android-host release",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "sync:app-lynx-bundle": "node packages/app-lynx/scripts/sync-android-assets.mjs",
    "kill:app-lynx": "node scripts/kill-dev-server.mjs app-lynx --force",
    "kill:website": "node scripts/kill-dev-server.mjs website --force",
    "kill:all": "node scripts/kill-dev-server.mjs all --force",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "vite-plus": "1.0.0-rc.0"
  },
  "devEngines": {
    "node": {
      "version": ">=22.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.9.0"
}
