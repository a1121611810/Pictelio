{
  "name": "pictelio",
  "version": "1.5.6",
  "private": true,
  "description": "Pictelio monorepo - SolidJS Pixiv browser + landing page",
  "homepage": "https://a1121611810.github.io/pixivizer",
  "type": "module",
  "scripts": {
    "dev": "vp run --filter pictelio-app dev",
    "dev:app": "vp run --filter pictelio-app dev",
    "dev:app-lynx": "vp run --filter pictelio-app-lynx dev",
    "dev:website": "vp run --filter pictelio-website dev",
    "dev:android": "vp run --filter pictelio-app dev:android",
    "dev:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira dev",
    "build": "vp run --filter pictelio-app build",
    "build:app": "vp run --filter pictelio-app build",
    "build:app-lynx": "vp run --filter pictelio-app-lynx build",
    "build:website": "vp run --filter pictelio-website build",
    "build:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira build",
    "check": "vp run --filter pictelio-app check",
    "check:app": "vp run --filter pictelio-app check",
    "check:app-lynx": "vp run --filter pictelio-app-lynx check",
    "check:ugoira": "vp run --filter @pictelio/ugoira check",
    "check:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira check",
    "preview": "vp run --filter pictelio-app preview",
    "preview:app": "vp run --filter pictelio-app preview",
    "preview:app-lynx": "vp run --filter pictelio-app-lynx preview",
    "preview:website": "vp run --filter pictelio-website preview",
    "preview:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira preview",
    "test": "vp run --filter pictelio-app test",
    "test:app": "vp run --filter pictelio-app test",
    "test:app-lynx": "vp run --filter pictelio-app-lynx test",
    "test:ugoira": "vp run --filter @pictelio/ugoira test",
    "test:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira test",
    "test:app:all": "vp run --filter pictelio-app test:all",
    "test:watch": "vp run --filter pictelio-app test:watch",
    "test:agent-browser": "vp run --filter pictelio-app test:agent-browser",
    "lint": "vp run --filter pictelio-app lint",
    "lint:app": "vp run --filter pictelio-app lint",
    "lint:app-lynx": "vp run --filter pictelio-app-lynx lint",
    "lint:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira lint",
    "fmt": "vp run --filter pictelio-app fmt",
    "fmt:app": "vp run --filter pictelio-app fmt",
    "fmt:app-lynx": "vp run --filter pictelio-app-lynx fmt",
    "fmt:all": "vp run --parallel --filter pictelio-app --filter pictelio-app-lynx --filter pictelio-website --filter @pictelio/ugoira fmt",
    "fmt:check": "vp run --filter pictelio-app fmt:check",
    "build:android": "vp run --filter pictelio-app build:android",
    "build:android:release": "vp run --filter pictelio-app build:android:release",
    "release:github": "vp run --filter pictelio-app release:github",
    "release": "vp run --filter pictelio-app release",
    "release:dry": "vp run --filter pictelio-app release:dry",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "cap:copy": "vp run --filter pictelio-app cap:copy",
    "cap:sync": "vp run --filter pictelio-app cap:sync",
    "cap:open:android": "vp run --filter pictelio-app cap:open:android",
    "sync:app-lynx-bundle": "node packages/app-lynx/scripts/sync-android-assets.mjs",
    "openwiki:update": "openwiki --update",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "node": {
      "version": ">=20.19",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7"
  }
}
