#!/bin/sh
# pre-commit hook: 当源码有变更时自动更新 OpenWiki 文档
# 仅当 src/ 或 packages/ 或 AGENTS.md / CLAUDE.md 有 staged 变更时触发
if git diff --cached --name-only | grep -qE '^src/|^packages/|^AGENTS\.md$|^CLAUDE\.md$'; then
  echo "📝 检测到源码变更，正在更新 OpenWiki 文档..."
  if pnpm openwiki:update; then
    # 将 OpenWiki 变更纳入本次提交
    git add -A openwiki/
  else
    echo "⚠️ openwiki update 执行失败（不阻塞 commit）"
  fi
fi
