**/node_modules/
.pnpm-store/*
dist/
**/reports/
*.local
*.bak
.scratch/
viz/
.playwright-cli/*
**/.playwright-cli/
.codegraph/*
.worktrees/
.superpowers/
.DS_Store

# Lynx 构建产物
*.tsbuildinfo

# Superpowers generated plans/specs (kept locally, not in repo)
docs/superpowers/

# Fastlane metadata (auto-generated by release script)
fastlane/

# VitePress build output
packages/website/docs/.vitepress/dist/

# Temporary task reports (in website workspace)
packages/website/task-*-report.md

# Android signing secrets
# ADR-0203 宿主迁移：Gradle 工程从 packages/app/android 迁到 packages/android-host/android，
# keystore / jks / release 产物随工程一起走——忽略规则必须跟着换路径，
# 否则新路径下的签名材料将失去 ignore 保护（本地已存在的 pictelio-release.keystore 即证）。
packages/android-host/android/app/*.keystore
packages/android-host/android/app/*.jks
packages/android-host/android/app/release/
# packages/app/* 的细粒度忽略规则已随 T10 删包（#842）移除——目录不再存在，规则恒不命中。
# 本机磁盘若仍有该包的构建垃圾，用一条通用规则兜底防误提交：
packages/app/
# ADR-0203 决策 3：凭证事实源迁到 app-lynx；发布文案的 AI 配置随发布脚本迁到宿主包
packages/android-host/.env
packages/app-lynx/.env
packages/app/test-results/
# android-e2e 快照目录以 process.cwd() 定位，从仓库根误跑时会在根目录生成
/test-results/
packages/app/test/e2e/screenshots/

# ADR-0202：OTA web bundle 三件套通道已下线，ota/ 不再产出任何产物。
# ignore 条目保留作防御——release.mjs step 4 的「发布无关变更拦截」对未跟踪文件同样生效，
# 旧版本残留的本地 ota/ 目录不应污染发布检查。
packages/app/ota/

# iOS — not targeted (Android-only)
packages/app/ios/

# Gradle 用户缓存（GRADLE_USER_HOME 约定在仓库根，见 scripts/release 流程）
/android/
packages/app/bench-results/
packages/app/tests/agent-browser/.token-state.json
