    {
      "id": "claim_3eda17df10f64623ababa13ea503abe4",
      "statement": "The app-lynx API client selects between two transport modes at request time via isNativeMode(), which probes NativeModules (bare global and globalThis) for real Pictelio* modules: native mode forwards through NativeModules.PictelioApi into Java, while web mode uses fetch through the /pixiv-api and /pixiv-oauth dev proxy paths.",
      "evidence": [
        {
          "resource": "repo://docs/adr/ADR-0053-lynx-nativemodule-contract.md#L26-L53",
          "version": "repo-lines-v1:sha256:faf6881c59ee54db15ee7f347d588eeed3414c17ce4bc951e5bc6621069db593:"
        },
