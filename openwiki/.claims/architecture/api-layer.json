    {
      "id": "claim_18e1613859644a0daae60d012957da66",
      "statement": "The JS side implements the ADR-0004 401 retry pattern in execWithAuthRetry: a module-level refreshPromise is shared so concurrent UNAUTHORIZED responses await a single onUnauthorizedHandler invocation and then replay their request once, with authStore registering that handler to run performRefresh and report a session error only when a refresh failure also leaves the session not ready.",
      "evidence": [
        {
          "resource": "repo://docs/adr/0004-401-concurrent-retry-promise-queue.md#L1-L24",
          "version": "repo-lines-v1:sha256:6eed36511846ef75ad6af583a16f8d71a8751df7df2c87e839c75925305a9830:"
