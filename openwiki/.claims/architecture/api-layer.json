    {
      "id": "claim_9c5c154cff8f4074b238c70ca46be9e5",
      "statement": "PixivApiCore.executeRequest silently handles 401 on the native path by taking a synchronized block that refreshes once (guarded by isRefreshing and an access_token reference-identity check so concurrent 401s share one refresh), then replays the original request with isRetry=true; refreshAccessTokenCore returns null on failure so the original 401 surfaces to JS.",
      "evidence": [
        {
          "resource": "repo://packages/android-host/android/app/src/main/java/io/pictelio/app/PixivApiCore.java#L141-L182",
