    {
      "id": "claim_4e8057577e3a400ba4dd0bcd20d8878b",
      "statement": "Release signing is configured in `android/app/build.gradle` to read `pictelio-release.keystore` (alias `pictelio`) and the `PICTELIO_KEYSTORE_PASSWORD`/`PICTELIO_KEY_PASSWORD` environment variables, and `validateReleaseSigning()` runs only when a release task is in the Gradle task graph, so debug builds never require the keystore or passwords.",
      "evidence": [
        {
          "resource": "repo://packages/android-host/android/app/build.gradle#L138-L157",
          "version": "repo-lines-v1:sha256:fdb94cd28a947659bc2ad0ce00370cf120b964a3758a62cb896bb127dfa10eec:"
