          "version": "repo-lines-v1:sha256:343b018f17e797905429fa040f7e777ac449ed90a1adadf3ccb923662aea5fd1:"
        }
      ]
    },
    {
      "id": "claim_f461167df6e14888b9e7909b059dd999",
      "statement": "Release must run on the target branch (default `main`, overridable via `PICTELIO_RELEASE_BRANCH`, which switches branch check, divergence preflight, and push target together); it rejects pre-existing tags and, per ADR-0142, fails fast before the confirmation prompt when `origin/<branch>` has commits the local branch lacks.",
      "evidence": [
