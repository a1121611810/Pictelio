  "claims": [
    {
      "id": "claim_2f832bf06be7470fb14b62a9e764499c",
      "statement": "The interactive one-command release is `pnpm release:android-host` (root) / `node scripts/release.mjs` (host package); it is TTY-only and has three modes: `-i` interactive commit selection (default), `-c` custom changelog, and `-o`/`--overwrite` to repair an already-published Release without bumping the version, while the retired OTA flags `--web-only`/`--min-web` fail loudly instead of silently running a full release.",
      "evidence": [
        {
          "resource": "repo://package.json#L50-L52",
          "version": "repo-lines-v1:sha256:02dcd53bfa3489da1f83a1c647e5489c5cae0f5f866126ee7e894d841aaac85d:"
        },
