    {
      "id": "claim_d62f3516bead4b87bda4d219c4135e01",
      "statement": "The product version source of truth is `packages/app-lynx/package.json`; `sync-android-version.mjs` reads it and rewrites `build.gradle` `versionCode`/`versionName` using `versionCode = major*10000 + minor*100 + patch` (minor and patch must be < 100), and the release flow bumps exactly `app-lynx/package.json`, `android/app/build.gradle`, and `packages/website/version.json`.",
      "evidence": [
        {
          "resource": "repo://packages/android-host/scripts/lib/release-utils.mjs#L228-L240",
          "version": "repo-lines-v1:sha256:c80b7dfc84573d0dc8859a0d7793a17c0435c8dc4ccc32beaa52cc149fb1dcfb:"
