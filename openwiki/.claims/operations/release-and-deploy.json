    {
      "id": "claim_f64e8d029f0b4f14b08b148cbfcf1eb0",
      "statement": "The release APK build is a fixed step sequence — sync credentials, build the Lynx bundle with `NODE_ENV=production`, sync `main.lynx.bundle` into Android assets, then `./gradlew assembleRelease renameReleaseApk` — producing a single `pictelio-{version}-release.apk` because the only publishable build type is `release`.",
      "evidence": [
        {
          "resource": "repo://packages/android-host/scripts/lib/release-build-steps.mjs#L59-L83",
          "version": "repo-lines-v1:sha256:b804765ea8c4aa964bb26eb87b8e2213600172c187ebec0cdd4aa886357e98e3:"
        },
        {
          "resource": "repo://packages/android-host/scripts/lib/release-utils.mjs#L35-L53",
          "version": "repo-lines-v1:sha256:a01b39e254b14429e978d551819349c4ea7fe803a0417348951cb149b5214027:"
        }
