    {
      "id": "claim_8a1af6b6d2e14475b6cc4444ec09acc7",
      "statement": "The normal release flow runs six steps — check signing env, bump version + write changelog/version.json, build the APK, git commit + tag (rejecting unrelated workspace changes), `git push origin <branch> --tags` with 3 retries, and `gh release create` plus per-asset upload — and its catch handler provides step-specific rollback or manual recovery commands.",
      "evidence": [
        {
          "resource": "repo://packages/android-host/scripts/release.mjs#L756-L947",
          "version": "repo-lines-v1:sha256:c980ab99e2f4f5544cc0cc9043d4c6df1056450d947345e779fe30d315ce4e77:"
        },
