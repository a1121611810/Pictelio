{
  "globals": {
    "batch": "readonly",
    "children": "readonly",
    "createContext": "readonly",
    "createDeferred": "readonly",
    "createEffect": "readonly",
    "createMemo": "readonly",
    "createRenderEffect": "readonly",
    "createResource": "readonly",
    "createRoot": "readonly",
    "createSelector": "readonly",
    "createSignal": "readonly",
    "ErrorBoundary": "readonly",
    "For": "readonly",
    "Index": "readonly",
    "indexArray": "readonly",
    "lazy": "readonly",
    "mapArray": "readonly",
    "Match": "readonly",
    "mergeProps": "readonly",
    "observable": "readonly",
    "on": "readonly",
    "onCleanup": "readonly",
    "onError": "readonly",
    "onMount": "readonly",
    "Show": "readonly",
    "splitProps": "readonly",
    "Suspense": "readonly",
    "SuspenseList": "readonly",
    "Switch": "readonly",
    "untrack": "readonly",
    "useContext": "readonly",
    "useTransition": "readonly",
    "createMutable": "readonly",
    "createStore": "readonly",
    "produce": "readonly",
    "reconcile": "readonly",
    "Dynamic": "readonly",
    "hydrate": "readonly",
    "isServer": "readonly",
    "Portal": "readonly",
    "render": "readonly",
    "renderToString": "readonly",
    "renderToStringAsync": "readonly",
    "renderToStream": "readonly",
    "getRouteApi": "readonly",
    "Outlet": "readonly",
    "RouterProvider": "readonly",
    "useLocation": "readonly",
    "useNavigate": "readonly",
    "useParams": "readonly",
    "useRouter": "readonly",
    "useSearch": "readonly",
    "tryAsync": "readonly",
    "trySync": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "curly": ["warn"],
    "capitalized-comments": ["warn"],
    "require-unicode-regexp": ["warn"],
    "require-await": ["warn"],
    "catch-error-name": ["warn"],
    "numeric-separators-style": ["warn"],
    "no-inline-comments": ["warn"],
    "no-underscore-dangle": [
      "warn",
      { "allow": ["_didMount", "_willUpdate", "__dirname", "__e2eServerProcess"] }
    ],
    "eqeqeq": ["warn", "always", { "null": "ignore" }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.test.ts", "tests/**/*.browser.test.ts", "tests/**/*.e2e.ts"],
      "rules": {
        "no-unused-vars": [
          "error",
          { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_|^vi$|^beforeEach$|^afterEach$" }
        ],
        "no-underscore-dangle": "off",
        "require-unicode-regexp": "off",
        "require-await": "off",
        "no-inline-comments": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-inline-comments": "off"
      }
    },
    {
      "files": ["src/components/**/*.tsx", "src/primitives/**/*.ts"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    }
  ]
}
