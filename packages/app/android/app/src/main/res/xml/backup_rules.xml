<?xml version="1.0" encoding="utf-8"?>
<!--
  全量备份排除规则 — Android 11- (API 30-)
  与 data_extraction_rules.xml 同步排除 SecureStorage 密文文件与
  Native 历史明文残留文件，确保旧版本 Android 也受到保护。
-->
<full-backup-content>
  <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
  <exclude domain="sharedpref" path="PictelioPrefs.xml" />
</full-backup-content>
