{
	"appId": "io.pictelio.app",
	"appName": "Pictelio",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"app-api.pixiv.net",
			"i.pximg.net"
		]
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"packageClassList": [
		"SecureStorage",
		"AppPlugin",
		"DevicePlugin",
		"PreferencesPlugin"
	]
}
