{
  "name": "pictelio-app",
  "version": "6.3.0",
  "private": true,
  "description": "Pictelio SPA - Pixiv illustration browser built with SolidJS + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp -C ../.. fmt --check && vp -C ../.. lint && tsc --noEmit -p tsconfig.json",
    "preview": "vp preview",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:agent-browser": "vitest run -c vitest.agent-browser.config.ts",
    "test:android:e2e": "vitest run -c tests/android-e2e/vitest.config.ts",
    "appium:setup": "APPIUM_HOME=$HOME/.appium appium driver install uiautomator2 && APPIUM_HOME=$HOME/.appium appium driver doctor uiautomator2",
    "test:all": "vp run test && vp run test:agent-browser",
    "lint": "vp -C ../.. lint",
    "fmt": "vp -C ../.. fmt --write",
    "fmt:check": "vp -C ../.. fmt --check",
    "sync:android-version": "pnpm --dir ../android-host run sync:android-version",
    "sync:credentials": "pnpm --dir ../android-host run sync:credentials",
    "build:android": "pnpm --dir ../android-host run build:android",
    "build:android:release": "pnpm --dir ../android-host run build:android:release",
    "release": "pnpm --dir ../android-host run release",
    "dev:android": "pnpm --dir ../android-host run dev:android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@chenglou/pretext": "^0.0.9",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@pictelio/net-diagnostics": "workspace:*",
    "@pictelio/novel-export": "workspace:*",
    "@pictelio/ranking-core": "workspace:*",
    "@pictelio/search-core": "workspace:*",
    "@pictelio/ugoira": "workspace:*",
    "@pictelio/update-check": "workspace:*",
    "@solid-primitives/i18n": "3.0.0-next.4",
    "@solid-primitives/intersection-observer": "3.0.0-next.3",
    "@solid-primitives/scroll": "3.0.0-next.4",
    "@solidjs/router": "2.0.0-next.27",
    "@solidjs/web": "2.0.0-rc.9",
    "@tanstack/query-persist-client-core": "5.101.4",
    "@tanstack/solid-query": "6.0.0-rc.3",
    "@tanstack/virtual-core": "3.17.11",
    "comlink": "^4.4.2",
    "ora": "^9.4.1",
    "solid-js": "2.0.0-rc.9",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@types/node": "^26.6.2",
    "agent-browser": "^0.34.0",
    "appium": "^3.7.0",
    "canvas": "^3.2.3",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^30.1.1",
    "json5": "^2.2.3",
    "modern-css-reset": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^6.0.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1",
    "webdriverio": "^9.32.0"
  }
}
