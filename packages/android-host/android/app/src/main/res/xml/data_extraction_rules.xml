<?xml version="1.0" encoding="utf-8"?>
<!--
  备份排除规则 — Android 12+ (API 31+)
  @aparajita/capacitor-secure-storage 8.x 自研 AES/GCM + AndroidKeyStore 加密，
  密文落盘文件名为 WSSecureStorageSharedPreferences.xml（见插件 SecureStorage.java）。

  排除该文件确保云备份和跨设备传输不会泄露加密后的敏感凭据；
  PictelioPrefs.xml 为历史明文残留（旧版本 Native 层写入），纵深防御一并排除。
  应用启动时通过 secureStorage.restoreRefreshToken() 自检确认完整性。
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    <exclude domain="sharedpref" path="PictelioPrefs.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    <exclude domain="sharedpref" path="PictelioPrefs.xml" />
  </device-transfer>
</data-extraction-rules>
