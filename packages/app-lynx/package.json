{
  "name": "pictelio-app-lynx",
  "version": "0.1.0",
  "private": true,
  "description": "Pictelio Lynx client - vue-lynx MVP (login / recommended illusts / novel / profile + client switch)",
  "type": "module",
  "scripts": {
    "dev": "PICTELIO_LYNX_DEV=1 rspeedy dev",
    "build": "rspeedy build",
    "preview": "rspeedy preview",
    "check": "vue-tsc --noEmit -p src/tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'lint 暂豁免：app-lynx 存量风格债清偿后接入 root vp lint（范围裁定见 ADR-0185）'",
    "fmt": "echo 'fmt 暂豁免：app-lynx 待清债后接入 root vp fmt（范围裁定见 ADR-0185）'",
    "test:lynx-web": "bash scripts/test-lynx-web.sh"
  },
  "dependencies": {
    "@lynx-js/web-core": "^0.23.1",
    "@pictelio/net-diagnostics": "workspace:*",
    "@pictelio/novel-export": "workspace:*",
    "@pictelio/ranking-core": "workspace:*",
    "@pictelio/search-core": "workspace:*",
    "@pictelio/ugoira": "workspace:*",
    "@pictelio/update-check": "workspace:*",
    "@tanstack/vue-query": "^5.103.2",
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.0.3",
    "spark-md5": "^3.0.2",
    "vue": "3.5.40",
    "vue-lynx": "^0.5.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@lynx-js/rspeedy": "^0.13.6",
    "@lynx-js/tailwind-preset": "^0.5.1",
    "@material/material-color-utilities": "^0.4.0",
    "@rsbuild/plugin-vue": "^1.2.6",
    "@types/node": "^26.6.2",
    "@types/spark-md5": "^3.0.3",
    "fake-indexeddb": "^6.2.5",
    "https-proxy-agent": "^9.1.0",
    "json5": "^2.2.3",
    "rsbuild-plugin-tailwindcss": "^0.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=18"
  }
}
