        {
          "id": 148356542,
          "title": "C108新刊ホントはギャルの桃乃さんサンプル",
          "type": "illust",
          "image_urls": {
            "square_medium": "https://i.pximg.net/c/540x540_10_webp/img-master/img/2026/08/13/02/50/12/148356542_p0_square1200.jpg",
